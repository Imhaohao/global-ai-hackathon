{
  "name": "leaf-doctor-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint shared backend/src backend/convex bridge/src",
    "typecheck": "tsc -p shared && tsc -p backend && tsc -p backend/convex && tsc -p bridge",
    "test": "tsx --test shared/src/*.test.ts shared/src/localModel/*.test.ts backend/src/*.test.ts bridge/src/*.test.ts",
    "eval:local-model": "tsx shared/src/localModel/evalLocalModel.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
