{
  "name": "@leaf-doctor/video-technical",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "node scripts/generateVoice.ts",
    "music": "node scripts/generateMusic.ts",
    "check:voice": "node scripts/checkVoice.ts",
    "credits": "node scripts/writeCredits.ts",
    "render": "remotion render src/index.ts Technical out/Technical.raw.mp4 --crf=16 && node scripts/masterAudio.ts out/Technical.raw.mp4 out/Technical.mp4 && node scripts/writeCredits.ts",
    "still": "remotion still src/index.ts Technical",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "analysis": "cd ../.. && training/.venv/bin/python -W ignore videos/technical/analysis/chroma.py && training/.venv/bin/python -W ignore videos/technical/analysis/gradcam.py"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "^4.0.529",
    "@remotion/google-fonts": "^4.0.529",
    "@remotion/tailwind-v4": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
