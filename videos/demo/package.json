{
  "name": "@leaf-doctor/demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts DemoVideo out/DemoVideo.raw.mp4 --crf=18 && node scripts/masterAudio.ts out/DemoVideo.raw.mp4 out/DemoVideo.mp4 && node scripts/writeCredits.ts",
    "still": "remotion still src/index.ts DemoVideo",
    "voice": "node scripts/generateVoice.ts",
    "checkVoice": "node scripts/checkVoice.ts",
    "music": "node scripts/generateMusic.ts",
    "credits": "node scripts/writeCredits.ts",
    "media": "node scripts/prepareMedia.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/tailwind-v4": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
