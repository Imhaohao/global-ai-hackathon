{
  "expo": {
    "name": "Leaf Doctor",
    "slug": "leaf-doctor",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.hacknation.leafdoctor",
      "appleTeamId": "K2MB68Z582"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.hacknation.leafdoctor",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Leaf Doctor uses the camera to take a photo of a coffee leaf. The photo stays on your phone.",
          "photosPermission": "Leaf Doctor opens your photos so you can check a leaf picture you already took. Photos stay on your phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Leaf Doctor saves where you are with each check so your field officer knows which part of the farm. The location stays on your phone unless you send a case by text message.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "react-native-fast-tflite",
      "expo-secure-store"
    ]
  }
}
