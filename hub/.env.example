# Optional. The hub talks to https://ideal-civet-53.convex.site unless you set another backend URL here.
EXPO_PUBLIC_BACKEND_URL=
# The server access token is not an environment variable. The co-op worker pastes it into the
# "Connect to Leaf Doctor server" card on the phone, and it is stored in the Android Keystore.

# Optional: pick a model from shared/src/localModel/modelCatalog.ts (defaults to ACTIVE_LOCAL_MODEL_ID).
EXPO_PUBLIC_LOCAL_MODEL_ID=
