# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Twilio Console > Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number farmers text, in E.164 form, e.g. +15551234567
TWILIO_PHONE_NUMBER=

# Public URL Twilio calls (your tunnel or deploy URL, no trailing slash).
# Twilio signs this exact URL, so it must match what you paste into the Twilio console.
PUBLIC_BASE_URL=

# Shared secret the hub phone sends as "Authorization: Bearer <token>". Generate with: openssl rand -hex 24
HUB_TOKEN=

PORT=8787
