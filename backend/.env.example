# The backend runs on Convex. Secrets live in the Convex deployment, not in a file.
# Set each one from this folder (backend/):
#
#   npx convex env set ANTHROPIC_API_KEY <your Claude API key>
#   npx convex env set TWILIO_ACCOUNT_SID <Twilio Console > Account info>
#   npx convex env set TWILIO_AUTH_TOKEN <Twilio Console > Account info>
#   npx convex env set TWILIO_PHONE_NUMBER <+15551234567>
#   npx convex env set TWILIO_VERIFY_SERVICE_SID <Twilio Verify > Services > VA...>
#   npx convex env set HUB_TOKEN $(openssl rand -hex 24)
#
# Twilio "A message comes in" webhook: <CONVEX_SITE_URL>/sms  (HTTP POST)
# Hub phone EXPO_PUBLIC_BACKEND_URL:     <CONVEX_SITE_URL>
# CONVEX_SITE_URL is printed in backend/.env.local after `npx convex dev`.
# SMS login needs a Twilio Verify service with SMS enabled. No secret belongs in mobile/.
# Mobile EXPO_PUBLIC_BACKEND_URL can override the default Convex site URL.
