{
  "name": "@leaf-doctor/reels",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Demo out/Demo.raw.mp4 --crf=18 && node scripts/masterAudio.ts out/Demo.raw.mp4 out/Demo.mp4",
    "still": "remotion still src/index.ts Demo",
    "copy": "node scripts/generateCopy.ts",
    "voice": "node scripts/generateVoice.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "sound": "python3 scripts/sound.py",
    "photos": "python3 scripts/fetchPhotos.py"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@remotion/cli": "^4.0.529",
    "@remotion/google-fonts": "^4.0.529",
    "@remotion/tailwind-v4": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
